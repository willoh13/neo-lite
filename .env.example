# ──────────────────────────────────────────────────────────────────────────
# NEO Lite — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env
# 2. Fill in at least ONE API key below
# 3. (Optional) Set a license key for higher tier access
# 4. Run: docker compose up -d
#
# License Keys:
#   None / NEO-FREE-XXXX   — Free tier (5 conversations/day, configurable)
#   NEO-MASTER-XXXX         — Unlimited conversations (affiliates/influencers)
#   NEO-EVAL-XXXX           — 14-day unlimited evaluation

# === REQUIRED: Pick ONE API provider (or more, just fill what you have) ===

# DeepSeek (cheapest — ~$0.50/mo for casual use)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI (GPT-4o, o3-mini, GPT-4.1)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Anthropic (Claude Sonnet 4, Opus)
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (200+ models — GPT, Claude, Gemini, Llama, and more)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Google Gemini (Gemini 2.0 Flash, Pro)
# Get key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...

# xAI Grok (Grok-2)
# Get key: https://console.x.ai
# XAI_API_KEY=xai-...

# === OPTIONAL: License Key ===
# Get yours at https://neocloud.ai/pricing
NEO_LICENSE_KEY=

# === OPTIONAL: Conversation Limit ===
# Only applies to FREE tier. Default: 5. Set higher to test.
NEO_DAILY_LIMIT=5

# === OPTIONAL: Telegram Integration ===
# 1. Create a bot with @BotFather on Telegram
# 2. Set the token here:
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_ALLOWED_USERS=your_telegram_user_id
# TELEGRAM_HOME_CHANNEL=your_telegram_user_id

# === DON'T CHANGE THESE ===
OLLAMA_API_KEY=neo-lite-internal
TERMINAL_ENV=local
