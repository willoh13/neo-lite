# ──────────────────────────────────────────────────────────────────────────
# NEO Operator — Environment Variables (BYOK: Bring Your Own Keys)
# ──────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env
# 2. Fill in the API keys for the providers you have access to
# 3. NEO Operator routes tasks to the best model you have unlocked
# 4. Run: docker compose up -d
#
# BYOK principle: You never pay NEO Operator for inference. You bring keys
# to providers you already have, and NEO's delegation router picks the
# best model per task from what you've configured.
#
# No license key. No rate limit. NEO Operator is free and open source.

# === PROVIDERS: Fill what you have. Missing keys = provider unavailable. ===

# ── Local (Free, Private) ──────────────────────────────────────────────────
# Ollama runs on your machine. Zero cost, zero data leaves the box.
# NEO Operator prefers Ollama for privacy-sensitive tasks when available.
# Install: https://ollama.com/download
# Note: if running Ollama on the Docker host, use http://host.docker.internal:11434/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=

# ── Cloud (Cheap) ──────────────────────────────────────────────────────────

# DeepSeek — best $/performance for reasoning. ~$0.50/mo casual use.
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Gemini 2.0 Flash — fast, multimodal, generous free tier.
# Get key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq — extremely fast inference, generous free tier.
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# ── Cloud (Premium) ────────────────────────────────────────────────────────

# xAI Grok — best brand-voice match, real-time data.
# Get key: https://console.x.ai
XAI_API_KEY=

# OpenAI (GPT-4o, o3-mini, GPT-4.1)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Anthropic (Claude Sonnet 4, Opus)
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (200+ models — GPT, Claude, Gemini, Llama, and more)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# === OPTIONAL: Your AI's Name ===
# The first-run wizard will ask you. The default is "Assistant".
# You can change it any time by editing this file and restarting.
NEO_AI_NAME=

# === OPTIONAL: Your AI's Voice ===
# One of: casual (default) | formal | warm | terse | sarcastic
# - casual:    friendly, warm, occasional humor
# - formal:    measured, professional, no jokes
# - warm:      supportive, encouraging, asks how you're doing
# - terse:     minimal words, no fluff, just the answer
# - sarcastic: dry wit, calls you on your BS, fun
# Want a fully custom voice? Drop a personality.md in your NEO Operator folder.
NEO_AI_TONE=casual

# === OPTIONAL: Resource limits ===
# NEO Operator is always unlimited conversations. These just cap the container's
# memory and CPU so the AI doesn't eat your whole machine.
NEO_MEM_LIMIT=1g
NEO_CPUS=0.5

# === OPTIONAL: Telegram Integration ===
# 1. Create a bot with @BotFather on Telegram
# 2. Set the token here:
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_ALLOWED_USERS=your_telegram_user_id
# TELEGRAM_HOME_CHANNEL=your_telegram_user_id

# === DON'T CHANGE THESE ===
TERMINAL_ENV=local
